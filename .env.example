# Public base URL used in email links. Set to the tunnel URL or your domain.
APP_URL=http://localhost:3100

# Owner login
ADMIN_PASSWORD=change-me
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Owner signer defaults
OWNER_NAME=
OWNER_EMAIL=

# Email (optional). Without RESEND_API_KEY, links are printed to the console and shown in the UI.
RESEND_API_KEY=
MAIL_FROM=Company <noreply@example.com>

# Optional: data folder (default ./data)
# DATA_DIR=
