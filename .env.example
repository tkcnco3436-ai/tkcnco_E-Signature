# Public base URL used in email links. Set to the tunnel URL or your domain.
APP_URL=http://localhost:3100

# Owner login. At least 12 characters (shorter passwords are refused).
# Changing it logs out every existing session.
ADMIN_PASSWORD=change-me-to-a-long-password
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Owner signer defaults (OWNER_EMAIL also receives "your turn to sign" mails)
OWNER_NAME=
OWNER_EMAIL=

# Email (optional). Without RESEND_API_KEY, links are printed to the console and shown in the UI.
# With RESEND_API_KEY, MAIL_FROM is required (mail is not sent without it).
RESEND_API_KEY=
MAIL_FROM=Company <noreply@example.com>
# MAIL_DISABLED=1 never sends mail (logs it instead). Use it for tests.
# MAIL_DISABLED=1

# Email OTP identity check before signing: on (default) | off.
# Only enforced when mail can actually be sent (RESEND_API_KEY + MAIL_FROM, MAIL_DISABLED not set);
# otherwise it is skipped and signing works without it.
# SIGN_OTP=on
# Test only: with MAIL_DISABLED=1, OTP_TEST_MODE=1 still requires the OTP and prints the code
# to the server console ("[otp] <email> <code>") instead of mailing it. Never use in production.
# OTP_TEST_MODE=1

# Client IP source for audit log and rate limits:
#   none (default)  ignore X-Forwarded-For etc. (IP is recorded as unknown)
#   cloudflare      trust cf-connecting-ip (only when reached through cloudflared; scripts/start.ps1 sets this)
# TRUST_PROXY=none

# RFC 3161 signature timestamp (see README). Defaults: DigiCert, enabled, not required.
# TSA_URL=http://timestamp.digicert.com
# TSA_ENABLED=1
# TSA_REQUIRED=0

# Optional: data folder (default ./data)
# DATA_DIR=
